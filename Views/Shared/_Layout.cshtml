<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CalorieTracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-gray-50 min-h-screen">

    <nav class="bg-white border-b border-gray-200 px-6 py-3 flex items-center gap-8">
        <a href="/" class="text-lg font-semibold text-green-600">🥗 CalorieTracker</a>
        <a href="/" class="text-sm text-gray-600 hover:text-green-600">Dashboard</a>
        <a href="/diary" class="text-sm text-gray-600 hover:text-green-600">Diary</a>
        <a href="/food/search" class="text-sm text-gray-600 hover:text-green-600">Search Food</a>
        <a href="/goals" class="text-sm text-gray-600 hover:text-green-600">Goals</a>

        <div class="ml-auto flex items-center gap-4">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="text-sm text-gray-400">@User.Identity.Name</span>
                <form method="post" action="/account/logout">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="text-sm text-gray-400 hover:text-red-400 transition-colors">
                        Sign out
                    </button>
                </form>
            }
            else
            {
                <a href="/account/login"
                   class="text-sm text-green-500 hover:underline">Sign in</a>
            }
        </div>
    </nav>

    <main class="max-w-4xl mx-auto px-4 py-8">
        @RenderBody()
    </main>

    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>