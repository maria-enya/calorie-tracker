@model List<CalorieTracker.Services.FoodApi.FoodProduct>

@if (!Model.Any())
{
    <div class="text-center py-10 text-gray-400">
        No results found. Try a different search term.
    </div>
}
else
{
    <div class="grid gap-3">
        @foreach (var product in Model)
        {
            var cal = product.Nutriments?.CaloriesPer100g ?? 0;
            var protein = product.Nutriments?.ProteinPer100g ?? 0;
            var carbs = product.Nutriments?.CarbsPer100g ?? 0;
            var fat = product.Nutriments?.FatPer100g ?? 0;

            <div class="bg-white border border-gray-200 rounded-xl p-4" id="food-@product.Barcode">
                <div class="flex items-start justify-between gap-4">
                    <div class="flex-1">
                        <div class="font-medium text-gray-800">@product.ProductName</div>
                        @if (!string.IsNullOrEmpty(product.Brands))
                        {
                            <div class="text-xs text-gray-400 mt-0.5">@product.Brands</div>
                        }
                        <div class="flex gap-4 mt-2 text-xs text-gray-500">
                            <span>🔥 @cal.ToString("F0") kcal</span>
                            <span>🥩 @protein.ToString("F1")g protein</span>
                            <span>🍞 @carbs.ToString("F1")g carbs</span>
                            <span>🧈 @fat.ToString("F1")g fat</span>
                        </div>
                    </div>

                    <!-- Add to diary form -->
                    <div class="flex flex-col gap-2 min-w-[180px]">
                        <div class="flex gap-2">
                            <input type="number"
                                   id="grams-@product.Barcode"
                                   value="100"
                                   min="1"
                                   max="2000"
                                   class="w-20 border border-gray-300 rounded px-2 py-1 text-sm" />
                            <span class="text-xs text-gray-400 self-center">g</span>
                        </div>
                        <select id="meal-@product.Barcode"
                                class="border border-gray-300 rounded px-2 py-1 text-sm">
                            <option>Breakfast</option>
                            <option>Lunch</option>
                            <option selected>Dinner</option>
                            <option>Snack</option>
                        </select>
                        <button id="btn-@product.Barcode"
                                class="bg-green-500 hover:bg-green-600 text-white text-sm rounded-lg px-3 py-1.5 transition-colors"
                                hx-post="/food/add"
                                hx-target="#btn-@product.Barcode"
                                hx-swap="outerHTML"
                                hx-vals="js:{
                                        barcode: '@product.Barcode',
                                        foodName: '@Html.Raw(product.ProductName?.Replace("'", "\\'"))',
                                        grams: document.getElementById('grams-@product.Barcode').value,
                                        mealType: document.getElementById('meal-@product.Barcode').value,
                                        date: new Date().toISOString().split('T')[0]
                                    }">
                            + Add to diary
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}