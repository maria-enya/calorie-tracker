@model CalorieTracker.Services.CombinedSearchResult

@if (!Model.HasAny)
{
    <div class="text-center py-10 text-gray-400">
        <div class="text-3xl mb-2">🔍</div>
        <div>No results found. Try a different term or</div>
        <a href="/food/manual" class="text-green-500 hover:underline">add it manually →</a>
    </div>
}
else
{
    <!-- USDA Results — basic & whole foods -->
    @if (Model.UsdaResults.Any())
    {
        <div class="mb-2 flex items-center gap-2">
            <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">
                🥦 Basic & whole foods
            </span>
            <span class="text-xs text-gray-300">USDA database</span>
        </div>
        <div class="grid gap-3 mb-5">
            @foreach (var product in Model.UsdaResults)
            {
                @await Html.PartialAsync("_FoodResultCard", product)
            }
        </div>
    }

    <!-- OpenFoodFacts Results — packaged products -->
    @if (Model.OpenFoodFactsResults.Any())
    {
        <div class="mb-2 flex items-center gap-2">
            <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">
                📦 Packaged products
            </span>
            <span class="text-xs text-gray-300">OpenFoodFacts database</span>
        </div>
        <div class="grid gap-3">
            @foreach (var product in Model.OpenFoodFactsResults)
            {
                @await Html.PartialAsync("_FoodResultCard", product)
            }
        </div>
    }

    <!-- Manual entry link -->
    <div class="mt-5 text-center text-sm text-gray-400">
        Can't find what you're looking for?
        <a href="/food/manual" class="text-green-500 hover:underline ml-1">
            Add it manually →
        </a>
    </div>
}