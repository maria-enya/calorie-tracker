@{
    ViewData["Title"] = "Search Food";
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-800">Search Food</h1>
    <p class="text-gray-500 mt-1">Search from 600,000+ real food products</p>
</div>

<div class="bg-white rounded-xl border border-gray-200 p-6">
    <input type="text"
           id="search-input"
           name="query"
           placeholder="Search for a food (e.g. banana, chicken breast, oats...)"
           autocomplete="off"
           class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-green-400"
           hx-get="/food/results"
           hx-trigger="keyup changed delay:400ms"
           hx-target="#search-results"
           hx-indicator="#spinner" />

    <div id="spinner" class="htmx-indicator mt-3 text-sm text-gray-400">
        Searching...
    </div>
</div>

<div id="search-results" class="mt-4">
    <!-- htmx loads results here -->
</div>