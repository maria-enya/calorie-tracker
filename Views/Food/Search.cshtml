@{
    ViewData["Title"] = "Search Food";
}

<div class="mb-5 flex items-center justify-between">
    <div>
        <h1 class="text-xl font-semibold text-gray-800">Search Food</h1>
        <p class="text-gray-400 text-sm mt-0.5">Search from USDA + OpenFoodFacts databases</p>
    </div>
    <a href="/food/manual"
       class="text-sm border border-gray-300 text-gray-600 hover:border-green-400 hover:text-green-600 rounded-lg px-3 py-2 transition-colors whitespace-nowrap">
        + Add manually
    </a>
</div>

<div class="bg-white rounded-xl border border-gray-200 p-4 md:p-6">
    <input type="text"
           id="search-input"
           name="query"
           placeholder="Search food (e.g. baked potato, chicken breast, oats...)"
           autocomplete="off"
           class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-green-400"
           hx-get="/food/results"
           hx-trigger="keyup changed delay:400ms"
           hx-target="#search-results"
           hx-indicator="#spinner" />

    <div id="spinner" class="htmx-indicator mt-3 text-sm text-gray-400">
        Searching USDA + OpenFoodFacts...
    </div>
</div>

<div id="search-results" class="mt-4"></div>